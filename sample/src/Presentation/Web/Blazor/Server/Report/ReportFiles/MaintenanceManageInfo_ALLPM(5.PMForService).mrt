      <View_PMList Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>View_PMList</Alias>
        <Columns isList="true" count="21">
          <value>ReportTypeCode,System.Int32</value>
          <value>ReportType_Name,System.String</value>
          <value>Delayed,System.Boolean</value>
          <value>Device_NO,System.String</value>
          <value>MIE_Name,System.String</value>
          <value>MI_DemanCenters_CenterName,System.String</value>
          <value>APN_ProvinceName,System.String</value>
          <value>MIE_EquipmenDeviceStatus_Name,System.String</value>
          <value>SC_ServiceCode,System.String</value>
          <value>SF_Name,System.String</value>
          <value>SC_Name,System.String</value>
          <value>MIE_LastDateService,System.DateTime</value>
          <value>PM_UsersActionSet_UAS_ActionTitle,System.String</value>
          <value>Pe_PM_LastDateService,System.String</value>
          <value>PM_ArrangedDateService,System.DateTime</value>
          <value>DeadLine,System.Int32</value>
          <value>MIE_UserComment,System.String</value>
          <value>PM_Schedule_Name,System.String</value>
          <value>Pe_PM_ArrangedDateService,System.String</value>
          <value>Pe_MIE_LastDateService,System.String</value>
          <value>Device_Name,System.String</value>
        </Columns>
        <CommandTimeout>99999</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>871464936b9740fb86b08910bf625c68</Key>
        <Name>View_PMList</Name>
        <NameInSource>BehparvarGroup</NameInSource>
        <Parameters isList="true" count="2">
          <value>Pe_PM_LastDateService,Pe_PM_LastDateService,12,50</value>
          <value>idUser,idUser,8,50</value>
        </Parameters>
        <SqlCommand>declare @PM_LastDateService date;
set @PM_LastDateService = IntegrationDB.dbo.ShamsiToMiladi2(@Pe_PM_LastDateService);


select * from (
select  1 as ReportTypeCode,N'کارهای معوقه' as ReportType_Name, 
	Delayed,Device_Name,
	Device_NO,View_PMList.MIE_Name,View_PMList.MI_DemanCenters_CenterName,
	APN_ProvinceName,
	View_PMList.EDS_Name as MIE_EquipmenDeviceStatus_Name,SC_ServiceCode,SF_Name,
	SC_Name,PM_LastDateService as MIE_LastDateService,
	PM_UsersActionSet_UAS_ActionTitle,Pe_PM_LastDateService,PM_ArrangedDateService,
	DeadLine,PM_UserComment as MIE_UserComment,PM_Schedule_Name,
	Pe_PM_ArrangedDateService,Pe_PM_LastDateService as Pe_MIE_LastDateService
	from View_PMList
	where
	View_PMList.SC_Active = 1 and View_PMList.Device_Active = 1
	AND (View_PMList.EDS_Code = 1 or View_PMList.Device_EDS_Code = 1)
	AND (NOT(View_PMList.DC_TechnicalExpert is null) OR
	NOT(View_PMList.Vehicle_DC_TechnicalExpert is null))
AND (View_PMList.MI_Parent_Equipment IS NULL)
AND DeadLine &lt; 0 
AND
(
(
DC_TechnicalExpert = 
	(
SELECT        TOP (1) WFUSER_HoldingCompanies.idUser
		FROM            WFUSER_HoldingCompanies INNER JOIN
								 WFUSER_HoldingCompanies AS WFUSER_HoldingCompanies_1 ON WFUSER_HoldingCompanies.IdHoldingCompanies = WFUSER_HoldingCompanies_1.IdHoldingCompanies
		WHERE        (WFUSER_HoldingCompanies_1.idUser = @idUser) AND (WFUSER_HoldingCompanies.idUser = DC_TechnicalExpert)
	)
)
OR
Vehicle_DC_TechnicalExpert = 
	(
SELECT        TOP (1) WFUSER_HoldingCompanies.idUser
		FROM            WFUSER_HoldingCompanies INNER JOIN
								 WFUSER_HoldingCompanies AS WFUSER_HoldingCompanies_1 ON WFUSER_HoldingCompanies.IdHoldingCompanies = WFUSER_HoldingCompanies_1.IdHoldingCompanies
		WHERE        (WFUSER_HoldingCompanies_1.idUser = @idUser) AND (WFUSER_HoldingCompanies.idUser = Vehicle_DC_TechnicalExpert)
	)
)
AND (PM_LastDateService &lt;&gt;  @PM_LastDateService) 
AND ( 
   (Device_DC_WCenterManager = @idUser)
OR (MI_DemanCenters_CenterOstanName in (SELECT        KPA_ProvinceName
	FROM            dbo.KeyPostionsAssignment
	WHERE (KPA_PositioinName = 6) AND (KPA_WAssigneeName = @idUser)))
OR (DC_TechnicalExpert = @idUser)
OR (Vehicle_DC_TechnicalExpert = @idUser)

OR (1 =
(SELECT        TOP (1) ReportPMAdminPermission
                                FROM            dbo.View_WFuser AS View_WFuser_3
                                WHERE        (idUser = @idUser)))
)
union all
select 
	2 as ReportTypeCode,N'کارهایی که دیروز انجام شده است' as ReportType_Name,
	Delayed,Device_Name,Device_NO,View_PMList.MIE_Name,View_PMList.MI_DemanCenters_CenterName,
	APN_ProvinceName,
	View_PMList.EDS_Name as MIE_EquipmenDeviceStatus_Name,View_PMAlarm.SC_ServiceCode,
	View_PMAlarm.SF_Name,
	View_PMAlarm.SC_Name,MIE_LastDateService,
	PM_UsersActionSet_UAS_ActionTitle,Pe_PM_LastDateService,PM_ArrangedDateService,
	DeadLine,MIE_UserComment,View_PMAlarm.PM_Schedule_Name,Pe_PM_ArrangedDateService,
	Pe_MIE_LastDateService
	from View_PMList  WITH (NOLOCK) 
	INNER JOIN
	View_PMAlarm  WITH (NOLOCK) ON View_PMList.IdMIE_PMList = View_PMAlarm.MIE_PMList
where
(View_PMList.MI_Parent_Equipment IS NULL)
AND (View_PMList.EDS_Code = 1 or View_PMList.Device_EDS_Code = 1)
AND (View_PMAlarm.MIE_LastDateService =  @PM_LastDateService AND
View_PMAlarm.MIE_UsersActionSet = 613) 

AND (
	(
	DC_TechnicalExpert = 
		(
SELECT        TOP (1) WFUSER_HoldingCompanies.idUser
			FROM            WFUSER_HoldingCompanies  WITH (NOLOCK)  INNER JOIN
									 WFUSER_HoldingCompanies AS WFUSER_HoldingCompanies_1  WITH (NOLOCK) ON
									 WFUSER_HoldingCompanies.IdHoldingCompanies = WFUSER_HoldingCompanies_1.IdHoldingCompanies
			WHERE        (WFUSER_HoldingCompanies_1.idUser = @idUser) AND
			(WFUSER_HoldingCompanies.idUser = DC_TechnicalExpert)
		)
	)
	or
	(	
Vehicle_DC_TechnicalExpert = 
	(
SELECT        TOP (1) WFUSER_HoldingCompanies.idUser
		FROM            WFUSER_HoldingCompanies  WITH (NOLOCK) INNER JOIN
								 WFUSER_HoldingCompanies AS WFUSER_HoldingCompanies_1  WITH (NOLOCK) ON
								 WFUSER_HoldingCompanies.IdHoldingCompanies = WFUSER_HoldingCompanies_1.IdHoldingCompanies
		WHERE        (WFUSER_HoldingCompanies_1.idUser = @idUser)
		AND (WFUSER_HoldingCompanies.idUser = Vehicle_DC_TechnicalExpert)
	)
	)
)

AND ( 
   (Device_DC_WCenterManager = @idUser)
   or
   (Vehicle_DC_WCenterManager = @idUser)
OR (MI_DemanCenters_CenterOstanName in (SELECT        KPA_ProvinceName
	FROM            dbo.KeyPostionsAssignment  WITH (NOLOCK) 
	WHERE (KPA_PositioinName = 6) AND (KPA_WAssigneeName = @idUser)))

OR (DC_TechnicalExpert = @idUser)
OR (Vehicle_DC_TechnicalExpert = @idUser)
OR (1 =
(SELECT        TOP (1) ReportPMAdminPermission
                                FROM            dbo.View_WFuser AS View_WFuser_3  WITH (NOLOCK) 
                                WHERE        (idUser = @idUser)))
)
/*
union ALL
select top(0)
3 as ReportTypeCode,N'کارهای آینده' as ReportType_Name,
Delayed,Device_Name,
 Device_NO,View_PMList.MIE_Name,View_PMList.MI_DemanCenters_CenterName,
APN_ProvinceName,
View_PMList.EDS_Name as MIE_EquipmenDeviceStatus_Name,SC_ServiceCode,SF_Name,
SC_Name,PM_LastDateService as MIE_LastDateService,
PM_UsersActionSet_UAS_ActionTitle,Pe_PM_LastDateService,PM_ArrangedDateService,
DeadLine,PM_UserComment as MIE_UserComment,PM_Schedule_Name,Pe_PM_ArrangedDateService,Pe_PM_LastDateService as Pe_MIE_LastDateService
from View_PMList
where
DeadLine &gt;= 0 AND View_PMList.EDS_Code = 1 AND
(PM_LastDateService &lt;&gt;  IntegrationDB.dbo.ShamsiToMiladi2(@Pe_PM_LastDateService)) 
AND ( 
   (Device_DC_WCenterManager = @idUser)
OR (MI_DemanCenters_CenterOstanName in (SELECT        KPA_ProvinceName
FROM            dbo.KeyPostionsAssignment
WHERE        (KPA_PositioinName = 6) AND (KPA_WAssigneeName = @idUser)))

OR (DC_TechnicalExpert = @idUser)
OR (1 =
(SELECT        TOP (1) ReportPMAdminPermission
                                FROM            dbo.View_WFuser AS View_WFuser_3
                                WHERE        (idUser = @idUser)))
)
*/
) as ctb</SqlCommand>
      </View_PMList>
