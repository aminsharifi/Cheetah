        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT [IdAttendance]
	,[Att_StartDate]
	,[pe_Att_StartDate]
	,[Att_EndDate]
	,[pe_Att_EndDate]
	,[Att_Days]
	,[Att_LeaveDays]
	,[Att_Description]
	,[Loan]
	FROM [BehparvarGroup].[dbo].[View_Attendance]
	where not ([Loan] is null)</SqlCommand>
      </View_Attendance>
