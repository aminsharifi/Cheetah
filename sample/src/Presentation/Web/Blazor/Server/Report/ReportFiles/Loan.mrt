      <View_UsersCommentsHistory Ref="5" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>View_UsersCommentsHistory</Alias>
        <Columns isList="true" count="12">
          <value>IdUsersCommentsHistory,System.Int32</value>
          <value>fullName,System.String</value>
          <value>UAS_ActionTitle,System.String</value>
          <value>UCH_UserDescription,System.String</value>
          <value>pe_UCH_TaskRecieveDate,System.String</value>
          <value>pe_UCH_TaskSentDate,System.String</value>
          <value>SelectedFileImage,System.Byte[]</value>
          <value>RI_RequestNumber,System.String</value>
          <value>RequestInformation,System.Int32</value>
          <value>fuIdParent,System.Int32</value>
          <value>FileAddress,System.String</value>
          <value>fuFileName,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>054807c3c5514864b1bd7a31b572833e</Key>
        <Name>View_UsersCommentsHistory</Name>
        <NameInSource>BehparvarGroup</NameInSource>
        <Parameters isList="true" count="1">
          <value>RI_RequestNumber,RI_RequestNumber,12,50</value>
        </Parameters>
        <SqlCommand>select 
	IdUsersCommentsHistory,
	fullName,
	UAS_ActionTitle,
	UCH_UserDescription,
	pe_UCH_TaskRecieveDate,
	pe_UCH_TaskSentDate,
	SelectedFileImage,
	RI_RequestNumber,
	RequestInformation,
	[fuIdParent],[FileAddress],[fuFileName]
	from View_UsersCommentsHistory
	left join View_BAFILEUPLOAD on View_BAFILEUPLOAD.fuIdParent = IdUsersCommentsHistory
	WHERE        (RI_RequestNumber like N'%' + @RI_RequestNumber + N'%' OR @RI_RequestNumber = ' ')</SqlCommand>
      </View_UsersCommentsHistory>
