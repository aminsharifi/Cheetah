        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>2278fb975151442caaf9ed11d68bcd90</Key>
        <Name>View_Loan</Name>
        <NameInSource>BehparvarGroup</NameInSource>
        <Parameters isList="true" count="1">
          <value>RI_RequestNumber,RI_RequestNumber,12,500</value>
        </Parameters>
        <SqlCommand>SELECT top(1) idloan,AidKind_Name,LN_CommitteeDesc,RI_PE_RequestDate,RI_fullName,Companies_Province_Description,
	LN_LoanMaximumRepayment,LN_LoanDescription,Priority_Name,LN_Committee_UAS_ActionTitle,LN_LoanRepayment,LN_LoanInterruption,LN_InstallmentNumber,
	LN_LoanType,LoanType_Name,RI_RequestNumber,StaffName,LN_LoanCause,LN_AidKind,LN_AidAMount,LN_LoanDedicatedAmount,LN_AidDedicatedAmount,
	MeasurementUnitName,GoodsName,LN_LoanRequestAmount,LN_GeneralInfo,LN_AnotherPerson,LN_CheckRadNumber
	FROM View_Loan
	WHERE
		RI_RequestNumber like N'%' +@RI_RequestNumber + N'%'</SqlCommand>
      </View_Loan>
